{
  "security": {
    "type": "object",
    "description": "安全与权限",
    "hint": "管理管理员权限、登录凭据与网站访问白名单规则",
    "items": {
      "admin_only": {
        "type": "bool",
        "description": "仅管理员可用",
        "hint": "开启后仅机器人管理员与额外管理员可调用浏览器工具",
        "default": false
      },
      "extra_admin_uids": {
        "type": "list",
        "description": "额外管理员",
        "hint": "选择或添加拥有管理权限的用户 ID 列表",
        "default": [],
        "_special": "sender_id"
      },
      "storage_state_path": {
        "type": "string",
        "description": "管理凭据路径",
        "hint": "管理员专用的 Cookie / StorageState JSON 文件路径（仅管理员可用）",
        "default": ""
      },
      "whitelist_rules": {
        "type": "template_list",
        "description": "网站白名单",
        "hint": "添加非管理员允许访问的网站通配规则及对应权限",
        "default": [],
        "templates": {
          "rule": {
            "name": "白名单规则",
            "display_item": "domains",
            "items": {
              "domains": {
                "type": "list",
                "description": "目标域名/通配符列表",
                "hint": "输入域名或通配符（如 *.github.com、github.com），本规则内的所有操作权限均应用于该域名集合",
                "default": []
              },
              "allowed_actions": {
                "type": "list",
                "description": "允许的操作行为",
                "hint": "下拉勾选允许执行的操作",
                "default": [
                  "read",
                  "screenshot"
                ],
                "options": [
                  "read",
                  "click",
                  "fill",
                  "select",
                  "hover",
                  "focus",
                  "drag",
                  "press_key",
                  "scroll",
                  "screenshot",
                  "screenshot_full",
                  "download"
                ],
                "labels": [
                  "读取文本 (read)",
                  "点击交互 (click)",
                  "输入表单 (fill)",
                  "下拉选择 (select)",
                  "鼠标悬停 (hover)",
                  "焦点控制 (focus)",
                  "元素拖拽 (drag)",
                  "键盘按键 (press_key)",
                  "页面滚动 (scroll)",
                  "视口截图 (screenshot)",
                  "全页长截图 (screenshot_full)",
                  "下载文件 (download)"
                ]
              },
              "allow_single_hop": {
                "type": "bool",
                "description": "允许单跳放行",
                "hint": "开启后，允许该规则内的页面通过点击或弹窗等操作跳转到非白名单页面一次",
                "default": false
              },
              "single_hop_allowed_actions": {
                "type": "list",
                "description": "单跳页面允许的行为",
                "hint": "勾选单跳落地后在目标非白名单页面上允许执行的操作权限",
                "default": [
                  "read",
                  "screenshot"
                ],
                "options": [
                  "read",
                  "click",
                  "fill",
                  "select",
                  "hover",
                  "focus",
                  "drag",
                  "press_key",
                  "scroll",
                  "screenshot",
                  "screenshot_full",
                  "download"
                ],
                "labels": [
                  "读取文本 (read)",
                  "点击交互 (click)",
                  "输入表单 (fill)",
                  "下拉选择 (select)",
                  "鼠标悬停 (hover)",
                  "焦点控制 (focus)",
                  "元素拖拽 (drag)",
                  "键盘按键 (press_key)",
                  "页面滚动 (scroll)",
                  "视口截图 (screenshot)",
                  "全页长截图 (screenshot_full)",
                  "下载文件 (download)"
                ],
                "condition": {
                  "allow_single_hop": true
                }
              },
              "single_hop_follow_redirects": {
                "type": "bool",
                "description": "单跳遵循重定向",
                "hint": "开启后，单次页面内跳转过程中发生的 HTTP 301/302 重定向链视为同一次跳转并放行；关闭则拦截重定向",
                "default": true,
                "condition": {
                  "allow_single_hop": true
                }
              }
            }
          }
        }
      },
      "mask_password_inputs": {
        "type": "bool",
        "description": "脱敏密码输入框",
        "hint": "开启后，页面中 type='password' 的表单组件内容将被脱敏为 ******，防止敏感密码泄露给大模型；关闭后将输出实际明文内容",
        "default": true
      }
    }
  },
  "runtime": {
    "type": "object",
    "description": "会话与运行时",
    "hint": "配置浏览器上下文隔离粒度、超时回收及系统提示词",
    "items": {
      "context_mode": {
        "type": "string",
        "description": "隔离模式",
        "hint": "选择浏览器上下文的隔离粒度",
        "default": "personal",
        "options": [
          "personal",
          "session"
        ],
        "labels": [
          "个人隔离 (personal)",
          "会话共享 (session)"
        ],
        "subtitles": [
          "每个用户独享独立的浏览器标签与上下文",
          "同一群聊/私聊会话共享相同的浏览器上下文"
        ]
      },
      "idle_timeout_minutes": {
        "type": "int",
        "description": "空闲销毁时长",
        "hint": "上下文无交互超过此时长后自动关闭以释放内存 (分钟)",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 120,
          "step": 1
        }
      },
      "browser_idle_timeout_minutes": {
        "type": "int",
        "description": "浏览器进程空闲退出时长",
        "hint": "无活跃上下文时底层浏览器进程空闲退出时长 (分钟)，超时自动关闭 OS 进程释放内存；设置为 0 则保持常驻不退出",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 120,
          "step": 1
        }
      },
      "tool_execution_timeout_seconds": {
        "type": "int",
        "description": "执行超时时长",
        "hint": "单个工具执行的最长等待时间 (秒)",
        "default": 30,
        "slider": {
          "min": 5,
          "max": 180,
          "step": 5
        }
      },
      "enable_close_tool": {
        "type": "bool",
        "description": "注册关闭工具",
        "hint": "是否向大模型注册主动关闭浏览器的工具",
        "default": true
      },
      "system_prompt_injection": {
        "type": "text",
        "description": "系统提示词注入",
        "hint": "注入大模型的自定义系统提示词，留空则不注入",
        "default": ""
      },
      "content_extraction_mode": {
        "type": "string",
        "description": "页面正文提炼模式",
        "hint": "选择大模型阅读网页时使用的正文提取与结构化策略",
        "default": "inline_markdown",
        "options": [
          "inline_markdown",
          "aria_snapshot"
        ],
        "labels": [
          "内联交互 Markdown (Inline Markdown)",
          "无障碍语义树快照 (ARIA Snapshot)"
        ],
        "subtitles": [
          "将正文排版、嵌入图片与带 Ref 编号的可交互元素内联融合成一篇结构化文档，所见即所得",
          "基于浏览器原生 Accessibility Tree 生成角色层级树，结构严密但呈树状层级"
        ]
      },
      "page_chunk_char_limit": {
        "type": "int",
        "description": "分页字符预算",
        "hint": "单页正文提炼的最大字符预算（建议 1000 ~ 4000），超过此预算将在保持语义块完整性的前提下自动切分至下一页",
        "default": 2000,
        "slider": {
          "min": 500,
          "max": 1024000,
          "step": 100
        }
      }
    }
  },
  "browser": {
    "type": "object",
    "description": "浏览器引擎",
    "hint": "配置浏览器内核驱动、视口尺寸、无头模式及反爬选项",
    "items": {
      "browser_adapter": {
        "type": "string",
        "description": "浏览器适配器",
        "hint": "底层驱动引擎：Camoufox 自带反爬指纹伪装，Playwright 支持原生多浏览器",
        "default": "camoufox",
        "options": [
          "camoufox",
          "playwright"
        ],
        "labels": [
          "Camoufox (防检测)",
          "Playwright (原生引擎)"
        ],
        "subtitles": [
          "内置先进反检测与指纹伪装技术，爬虫防护网站首选",
          "原生支持 Chromium、Firefox、WebKit 及自定义可执行文件"
        ]
      },
      "playwright_browser_type": {
        "type": "string",
        "description": "Playwright 核心",
        "hint": "Playwright 的浏览器内核类型，选择'其他'时必须填写下方路径",
        "default": "chromium",
        "options": [
          "chromium",
          "firefox",
          "webkit",
          "custom"
        ],
        "labels": [
          "Chromium",
          "Firefox",
          "WebKit",
          "其他 (自定义路径)"
        ],
        "subtitles": [
          "兼具最佳性能与兼容性",
          "Firefox 核心",
          "Safari 核心",
          "使用本地 Chrome / Edge 等定制可执行文件"
        ],
        "condition": {
          "browser_adapter": "playwright"
        }
      },
      "browser_executable_path": {
        "type": "string",
        "description": "浏览器执行路径",
        "hint": "自定义浏览器二进制文件的完整绝对路径（选择'其他'时必填）",
        "default": "",
        "condition": {
          "playwright_browser_type": "custom"
        }
      },
      "camoufox_geoip": {
        "type": "bool",
        "description": "GeoIP 定位防检",
        "hint": "根据 IP 地址自动模拟时区与地理坐标",
        "default": false,
        "condition": {
          "browser_adapter": "camoufox"
        }
      },
      "browser_headless": {
        "type": "bool",
        "description": "无头模式",
        "hint": "后台静默运行，无需图形桌面支持",
        "default": true
      },
      "browser_window_width": {
        "type": "int",
        "description": "窗口宽度",
        "hint": "浏览器初始视口宽度 (像素)",
        "default": 1280,
        "slider": {
          "min": 800,
          "max": 3840,
          "step": 10
        }
      },
      "browser_window_height": {
        "type": "int",
        "description": "窗口高度",
        "hint": "浏览器初始视口高度 (像素)",
        "default": 720,
        "slider": {
          "min": 600,
          "max": 2160,
          "step": 10
        }
      },
      "browser_user_agent": {
        "type": "string",
        "description": "自定义 UA",
        "hint": "自定义 User-Agent，留空则使用适配器内置默认值",
        "default": ""
      }
    }
  },
  "media": {
    "type": "object",
    "description": "截图与交互输出",
    "hint": "配置文件截图格式、质量压缩、尺寸上限及元素文本处理",
    "items": {
      "screenshot_format": {
        "type": "string",
        "description": "截图格式",
        "hint": "页面截图输出的文件格式",
        "default": "png",
        "options": [
          "png",
          "jpeg"
        ],
        "labels": [
          "PNG (无损高清)",
          "JPEG (压缩优化)"
        ],
        "subtitles": [
          "画质清晰，文件体积相对较大",
          "支持调节压缩质量，节省网络带宽"
        ]
      },
      "screenshot_quality": {
        "type": "int",
        "description": "截图质量",
        "hint": "JPEG 格式时的图片压缩质量 (1~100)",
        "default": 80,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        },
        "condition": {
          "screenshot_format": "jpeg"
        }
      },
      "screenshot_max_height_px": {
        "type": "int",
        "description": "长截图高度上限",
        "hint": "全屏截取的最大像素高度，超出自动截断 (像素)",
        "default": 8000,
        "slider": {
          "min": 1000,
          "max": 30000,
          "step": 500
        }
      },
      "screenshot_timeout_seconds": {
        "type": "int",
        "description": "长截图超时时长",
        "hint": "长截图拼接渲染的超时秒数，超时自动降级为视口截图",
        "default": 15,
        "slider": {
          "min": 5,
          "max": 120,
          "step": 1
        }
      },
      "allow_screenshot_to_ai": {
        "type": "bool",
        "description": "截图发送给 AI",
        "hint": "允许大模型直接接收页面截图进行多模态视觉理解",
        "default": false
      },
      "element_multiline_separator": {
        "type": "string",
        "description": "元素换行替换符",
        "hint": "页面可操作元素提取时，内部换行符替换文本",
        "default": " | "
      }
    }
  },
  "storage_audit": {
    "type": "object",
    "description": "存储与审计管理",
    "hint": "配置本地持久化下载、截图路径及审计日志保留策略",
    "collapsed": true,
    "items": {
      "download_save_path": {
        "type": "string",
        "description": "下载保存路径",
        "hint": "浏览器下载文件保存的本地目录",
        "default": "data/plugin_data/astrbot_plugin_playwright_tools/downloads"
      },
      "screenshot_save_path": {
        "type": "string",
        "description": "截图保存路径",
        "hint": "截图文件保存的本地目录",
        "default": "data/plugin_data/astrbot_plugin_playwright_tools/screenshots"
      },
      "file_retention_days": {
        "type": "int",
        "description": "文件保留天数",
        "hint": "下载与截图文件保留天数，超时自动被动清理",
        "default": 7,
        "slider": {
          "min": 1,
          "max": 90,
          "step": 1
        }
      },
      "audit_retention_days": {
        "type": "int",
        "description": "审计保留天数",
        "hint": "审计记录保存天数，超过将自动清理",
        "default": 7,
        "slider": {
          "min": 1,
          "max": 365,
          "step": 1
        }
      },
      "audit_max_output_chars": {
        "type": "int",
        "description": "审计字符上限",
        "hint": "审计记录单条工具输出最大字符上限（0 表示不限长度）",
        "default": 0
      },
      "audit_save_screenshots": {
        "type": "bool",
        "description": "审计持久化截图",
        "hint": "是否在审计数据库中关联保存截图文件",
        "default": true
      }
    }
  },
  "history_cleanup": {
    "type": "object",
    "description": "工具历史消减与压缩",
    "hint": "当大模型对话中累积的本插件工具调用字符过多时，自动执行消减或由副 AI 压缩，防止超出上下文限制",
    "items": {
      "enable_cleanup": {
        "type": "bool",
        "description": "启用历史消减",
        "hint": "开启后，将监控本插件工具调用字符并在超标时自动消减",
        "default": false
      },
      "high_watermark": {
        "type": "int",
        "description": "高水位阈值 (字符)",
        "hint": "历史工具调用总字符超过此时触发清理（建议 5000 ~ 12000）",
        "default": 8000,
        "slider": {
          "min": 2000,
          "max": 1024000,
          "step": 1000
        },
        "condition": {
          "enable_cleanup": true
        }
      },
      "low_watermark": {
        "type": "int",
        "description": "低水位目标 (字符)",
        "hint": "触发清理后消减到的目标字符数（建议设为高水位的 30% ~ 50%）",
        "default": 3000,
        "slider": {
          "min": 1000,
          "max": 1024000,
          "step": 1000
        },
        "condition": {
          "enable_cleanup": true
        }
      },
      "cleanup_strategy": {
        "type": "string",
        "description": "消减策略",
        "hint": "直接替换为占位符删除，或调用另外一个 AI 生成紧凑摘要",
        "default": "delete",
        "options": [
          "delete",
          "compress"
        ],
        "labels": [
          "直接删除 (占位清空)",
          "AI 压缩 (总结提炼)"
        ],
        "subtitles": [
          "直接将历史正文清空替换为简短占位符，零额外开销",
          "唤起副 AI 提取网页关键事实与操作结论，保留历史认知"
        ],
        "condition": {
          "enable_cleanup": true
        }
      },
      "compress_provider_id": {
        "type": "string",
        "description": "压缩模型提供商",
        "hint": "选择负责执行压缩摘要的 AI 提供商；留空则使用当前会话默认模型",
        "default": "",
        "_special": "select_provider",
        "condition": {
          "enable_cleanup": true,
          "cleanup_strategy": "compress"
        }
      },
      "compress_max_input_chars": {
        "type": "int",
        "description": "副 AI 输入上限 (字符)",
        "hint": "送给副 AI 压缩的最大字符预算，设置为 0 代表不限制长度；大于 0 时若超出则直接截断",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 1024000,
          "step": 1000
        },
        "condition": {
          "enable_cleanup": true,
          "cleanup_strategy": "compress"
        }
      },
      "compress_prompt": {
        "type": "text",
        "description": "压缩提示词",
        "hint": "副 AI 执行总结提炼时遵循的核心指导原则；支持使用 {{user_input}} 动态占位符自动引入当前用户问题（如：根据用户问题“{{user_input}}”提炼核心事实）",
        "default": "你是一个精炼的内容总结器。请对以下浏览器历史操作及网页正文进行结构化提炼：保留核心事实、关键结论、数据指标及必要链接，剔除冗余修饰与排版，输出不超过 300 字的紧凑摘要。",
        "condition": {
          "enable_cleanup": true,
          "cleanup_strategy": "compress"
        }
      },
      "compress_use_persona": {
        "type": "bool",
        "description": "启用人设面具",
        "hint": "是否在压缩时注入人设设定",
        "default": false,
        "condition": {
          "enable_cleanup": true,
          "cleanup_strategy": "compress"
        }
      },
      "compress_persona_id": {
        "type": "string",
        "description": "指定人设面具",
        "hint": "选择用于压缩的人设面具；留空则自动选用当前系统默认人设",
        "default": "",
        "_special": "select_persona",
        "condition": {
          "enable_cleanup": true,
          "cleanup_strategy": "compress",
          "compress_use_persona": true
        }
      },
      "include_compressed_in_watermark": {
        "type": "bool",
        "description": "历史摘要计入水位",
        "hint": "开启后，此前已生成的 [历史浏览摘要] 也将计入水位统计并在再次超限时参与滚动重压缩；关闭后已压缩摘要不计入水位且不再重复压缩",
        "default": false,
        "condition": {
          "enable_cleanup": true
        }
      }
    }
  }
}
